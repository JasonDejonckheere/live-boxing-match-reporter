<h3 class="mt-4">All matches</h3>

<button class="btn btn-primary mb-4 mt-4" @onclick="OnAdd">Add Match</button>
@if (Matches is not null)
{
    <table class="table table-striped table-dark">
        <thead>
            <tr>
                @* <th scope="col">Match #</th> *@
                <th scope="col">Red team fighter</th>
                <th scope="col">Blue team fighter</th>
                <th scope="col">Status</th>
                @if(HasCrudRights)
                {
                    <th scope="col">Start match report</th>
                    <th scope="col">Edit</th>
                    <th scope="col">Delete</th>
                }
                else
                {
                    <th scope="col">View match</th>
                }

            </tr>
        </thead>
        <tbody>

            @foreach(var match in Matches)
            {
                <tr>
                    @* <td>@matchCount</td> *@

                    <td>@match.FighterBlueTeam.Firstname @match.FighterBlueTeam.Lastname (@match.FighterBlueTeam.WeightClass.ToString())</td>

                    <td>@match.FighterRedTeam.Firstname @match.FighterRedTeam.Lastname (@match.FighterRedTeam.WeightClass.ToString())</td>

                    <td>@(match.IsFinished ? $"Finished (winner: {match.WinningFighter.Firstname} {match.WinningFighter.Lastname})" : "Not finished") </td>

                    @if(HasCrudRights)
                    {
                            @if (!match.IsFinished)
                        {
                            <td>
                                <NavLink href="@($"/matchreport/{match.Id}")" class="btn btn-success">Start</NavLink>
                            </td>
                            <td>
                                <button class="btn btn-warning" @onclick="e => OnEdit.InvokeAsync(match)">Edit</button>
                            </td>
                        }
                        else
                        {
                            <td>Match finished</td>
                            <td>Match finished</td>
                        }
                    
                        <td>
                            <button class="btn btn-danger" @onclick="e => OnDelete.InvokeAsync(match)">Delete</button>
                        </td>
                    }
                    else
                    {
                        <td>
                            <button class="btn btn-danger" @onclick="e => OnView.InvokeAsync(match)">View</button>
                        </td>
                    }

                    
                </tr>

            }                    
        </tbody>
    </table>
}
else
{
    <h5>No matches have been found</h5>
}


@code {
    [Parameter]
    public bool HasCrudRights { get; set; } = false;

    [Parameter]
    public BoxingMatch[] Matches { get; set; }

    [Parameter]
    public EventCallback OnAdd { get; set; }

    [Parameter]
    public EventCallback<BoxingMatch> OnEdit { get; set; }

    [Parameter]
    public EventCallback<BoxingMatch> OnDelete { get; set; }

    [Parameter]
    public EventCallback<BoxingMatch> OnStart { get; set; }

    [Parameter]
    public EventCallback<BoxingMatch> OnView { get; set; }

}
