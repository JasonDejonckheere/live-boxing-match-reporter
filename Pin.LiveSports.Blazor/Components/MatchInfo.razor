@using Pin.LiveSports.Blazor.Pages
@inject IInMemoryMatchReportService inMemoryMatchReportService

@if(Match is null)
{
    <div>
        <p>Match not loaded in...</p>
        <button class="btn btn-succes" @onclick="e => OnFailedLoad.InvokeAsync()">Return to matches</button>
    </div>
}
else
{
    <div class="container mt-4">
        <div class="card shadow">
            <div class="card-header bg-dark text-white">
                <h3 class="mb-0 text-center">Match highlight events:</h3>
            </div>

            <div class="card-body">
                @if(!matchEvents.Any() || matchEvents is null)
                {
                    <div class="alert alert-secondary text-center">
                        No events yet.
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @for(int i = 1; i <= matchEvents.Count; i++)
                        {
                            <li class="list-group-item py-1">
                                <div class="d-flex justify-content-between align-content-lg-center">
                                    <div>
                                        <span>
                                            @(matchEvents.Count - i + 1). @matchEvents[matchEvents.Count - i].ToString()
                                        </span>
                                    </div>
                                </div>
                            </li>
                        }
                        @* }
                        @foreach(var e in matchEvents)
                        { *@
                            
                    </ul>
                }

            </div>
        </div>

    </div>
}

@code {
    private List<BaseMatchEvent> matchEvents;
    private BoxClient boxClient;

    [Parameter]
    public BoxingMatch Match { get; set; }

    [Parameter]
    public EventCallback OnFailedLoad { get; set; }

    protected override async Task OnInitializedAsync()
    {
        matchEvents = new List<BaseMatchEvent>();
        RefreshMatchEvents();
        boxClient = new BoxClient();
        boxClient.Configure(OnRemoteStateEvent, OnRemoteResultEvent, OnRemoteAttackEvent, OnRemoteRoundResultEvent);
        await boxClient.Start();

    }

    private async void OnRemoteStateEvent(MatchStateEvent e)
    {
        if(Match.Id == e.MatchId)
        {
            // matchEvents.Add(e);
            matchEvents = inMemoryMatchReportService.GetEventsByMatchId(e.MatchId);

            //otherwise app crashed cuz not on same thread
            await InvokeAsync(() =>
                this.StateHasChanged()
            );
        }
    }

    private async void OnRemoteResultEvent(MatchResultEvent e)
    {
        if (Match.Id == e.MatchId)
        {
            // matchEvents.Add(e);
            matchEvents = inMemoryMatchReportService.GetEventsByMatchId(e.MatchId);

            //otherwise app crashed cuz not on same thread
            await InvokeAsync(() =>
                this.StateHasChanged()
            );
        }
    }

    private async void OnRemoteAttackEvent(MatchAttackEvent e)
    {
        if (Match.Id == e.MatchId)
        {
            // matchEvents.Add(e);
            matchEvents = inMemoryMatchReportService.GetEventsByMatchId(e.MatchId);

            //otherwise app crashed cuz not on same thread
            await InvokeAsync(() =>
                this.StateHasChanged()
            );
        }
    }

    private async void OnRemoteRoundResultEvent(MatchRoundResultEvent e)
    {
        if (Match.Id == e.MatchId)
        {
            // matchEvents.Add(e);
            matchEvents = inMemoryMatchReportService.GetEventsByMatchId(e.MatchId);

            //otherwise app crashed cuz not on same thread
            await InvokeAsync(() =>
                this.StateHasChanged()
            );
        }
    }

    private void RefreshMatchEvents()
    {
        if (Match != null)
        {
            matchEvents = inMemoryMatchReportService.GetEventsByMatchId(Match.Id);
        }
    }
}
