@using Microsoft.AspNetCore.Components.QuickGrid
@inject IInMemoryMatchReportService inMemoryMatchReportService

@if(Match is null)
{
    <div>
        <p>Match not loaded in...</p>
        <a class="btn btn-succes" @onclick="e => OnReset.InvokeAsync()">Return to matches</a>
    </div>
}
else
{
    <div class="d-flex justify-content-center">
        <button class="btn btn-succes text-white bg-success" @onclick="e => OnReset.InvokeAsync()">Return to matches</button>
    </div>
    <div class="container mt-4">
        
        <div class="card shadow">
            <div class="card-header bg-dark text-white">
                <h3 class="mb-0 text-center">Match highlight events:</h3>
                <h5 class="my-2 text-center">
                    @Match.FighterBlueTeam.Firstname @Match.FighterBlueTeam.Lastname <span class="fw-bold" style="color: dodgerblue;">@scoreBlue </span>
                    
                    <span class="fw-bold">VS</span> 
                    <span class="fw-bold" style="color: red;"> @scoreRed</span> @Match.FighterRedTeam.Firstname @Match.FighterRedTeam.Lastname
                    
                </h5>
            </div>

            <div class="card-body">
                @if(!matchEvents.Any() || matchEvents is null)
                {
                    <div class="alert alert-secondary text-center">
                        No events yet.
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">

                        @* I used this as my new in .Net8 item *@
                        @* this is used to display data fast and simple in table format, extra options such as sorting and filtering can be applied if wanted
                            but for this i didnt need any specialities
                        *@
                        <QuickGrid Class="list-group-item py-1" Items="matchEvents.AsQueryable()">
                            <PropertyColumn Property="@(p => p.ToString())" Sortable="false" />
                        </QuickGrid>
                            
                    </ul>
                }

            </div>
        </div>

    </div>
}

@code {
    private List<BaseMatchEvent> matchEvents;
    private int scoreBlue = 0;
    private int scoreRed = 0;
    private BoxClient boxClient;

    [Parameter]
    public BoxingMatch Match { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }

    protected override async Task OnInitializedAsync()
    {
        matchEvents = new List<BaseMatchEvent>();
        RefreshMatchEvents();
        boxClient = new BoxClient();
        boxClient.Configure(OnRemoteStateEvent, OnRemoteResultEvent, OnRemoteAttackEvent, OnRemoteRoundResultEvent);
        await boxClient.Start();

    }

    private async void OnRemoteStateEvent(MatchStateEvent e)
    {
        if(Match.Id == e.MatchId)
        {
            // matchEvents.Add(e);
            matchEvents = inMemoryMatchReportService.GetEventsByMatchId(e.MatchId) ;

            //otherwise app crashed cuz not on same thread
            await InvokeAsync(() =>
                this.StateHasChanged()
            );
        }
    }

    private async void OnRemoteResultEvent(MatchResultEvent e)
    {
        if (Match.Id == e.MatchId)
        {
            // matchEvents.Add(e);
            matchEvents = inMemoryMatchReportService.GetEventsByMatchId(e.MatchId);

            //otherwise app crashed cuz not on same thread
            await InvokeAsync(() =>
                this.StateHasChanged()
            );
        }
    }

    private async void OnRemoteAttackEvent(MatchAttackEvent e)
    {
        if (Match.Id == e.MatchId)
        {
            // matchEvents.Add(e);
            matchEvents = inMemoryMatchReportService.GetEventsByMatchId(e.MatchId);

            //otherwise app crashed cuz not on same thread
            await InvokeAsync(() =>
                this.StateHasChanged()
            );
        }
    }

    private async void OnRemoteRoundResultEvent(MatchRoundResultEvent e)
    {
        if (Match.Id == e.MatchId)
        {
            // matchEvents.Add(e);
            matchEvents = inMemoryMatchReportService.GetEventsByMatchId(e.MatchId);
            scoreBlue = e.ScoreBlue;
            scoreRed = e.ScoreRed;

            //otherwise app crashed cuz not on same thread
            await InvokeAsync(() =>
                this.StateHasChanged()
            );
        }
    }

    private void RefreshMatchEvents()
    {
        if (Match != null)
        {
            matchEvents = inMemoryMatchReportService.GetEventsByMatchId(Match.Id);
        }
    }
}
