<h3 class="mt-4" >All fighters</h3>

<button class="btn btn-primary mb-4 mt-4" @onclick="OnAdd">Add Fighter</button>
@if(Fighters is not null)
{
    <table class="table table-striped table-dark">
        <thead>
            <tr>
                <th scope="col">Firstname</th>
                <th scope="col">Lastname</th>
                <th scope="col">Weight Class</th>
                <th scope="col">Amount of matches</th>
                <th scope="col">Edit</th>
                <th scope="col">Delete</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var fighter in Fighters)
            {
                <tr>
                    <td>@fighter.Firstname</td>
                    <td>@fighter.Lastname</td>
                    <td>@fighter.WeightClass.ToString()</td>
                    <td>@fighter.AssignedMatches.Count()</td>
                    <td>
                        <button class="btn btn-warning" @onclick="e => OnEdit.InvokeAsync(fighter)">Edit</button>
                    </td>
                    <td>
                        <button class="btn btn-danger" @onclick="e => OnDelete.InvokeAsync(fighter)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <h5>No fighters have been found</h5>
}


@code {
    [Parameter]
    public Fighter[] Fighters { get; set; }

    [Parameter]
    public EventCallback OnAdd { get; set; }

    [Parameter]
    public EventCallback<Fighter> OnEdit { get; set; }

    [Parameter]
    public EventCallback<Fighter> OnDelete { get; set; }

}
