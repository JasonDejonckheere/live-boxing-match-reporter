<h3>FighterList</h3>

@if(Fighters is not null)
{
    <table class="table table-striped table-dark">
        <thead>
            <tr>
                <th scope="col">Firstname</th>
                <th scope="col">Lastname</th>
                <th scope="col">Weight Class</th>
                <th scope="col">Amount of matches</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var fighter in Fighters)
            {
                <tr>
                    <td>@fighter.Firstname</td>
                    <td>@fighter.Lastname</td>
                    <td>@fighter.WeightClass.ToString()</td>
                    <td>@fighter.AssignedMatches.Count()</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <h5>No fighters have been found</h5>
}


@code {
    [Parameter]
    public Fighter[] Fighters { get; set; }
}
