
<EditForm Model="@Match" OnValidSubmit="@(e => OnSave.InvokeAsync(Match))">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group my-2">
        <div class="my-3">
            <label for="fighterblue">Blue team fighter: </label>

            <InputSelect TValue="Guid" @bind-Value="Match.FighterBlueTeamId">
                @foreach (var fighter in AvailableFighters)
                {
                    <option value="@fighter.Id">@fighter.Firstname @fighter.Lastname (@fighter.WeightClass.ToString())</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => Match.FighterBlueTeam)" />
        </div>
        <div class="my-3">
            <label for="fighterred">Red team fighter: </label>
            <InputSelect TValue="Guid" @bind-Value="Match.FighterRedTeamId">
                @foreach (var fighter in AvailableFighters)
                {
                    <option value="@fighter.Id">@fighter.Firstname @fighter.Lastname (@fighter.WeightClass.ToString())</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => Match.FighterRedTeam)" />
        </div>

    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <button type="button" class="btn btn-warning" @onclick="OnCancel">Cancel</button>
</EditForm>

@code {
    [Parameter]
    public Fighter[] AvailableFighters { get; set; }

    [Parameter]
    public BoxingMatch Match { get; set; }

    [Parameter]
    public EventCallback<BoxingMatch> OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }
}
