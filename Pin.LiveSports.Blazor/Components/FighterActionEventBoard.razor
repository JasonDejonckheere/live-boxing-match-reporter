<div class="card shadow-lg border-0 mx-auto mt-4" 
style="max-width: 500px; background-color:#1f2937; color:white; border-radius: 16px;">
    @if(Fighter is null)
    {
        <div class="card-body text-center" >
            <p class="text-danger">Fighter not loaded</p>
        </div>
    }
    else
    {
        <div class="card-header text-center border-0" style="background-color: #111827; border-radius: 16px 16px 0 0;">
            <h3 class="fw-bold mb-1">
                @Fighter.Firstname @Fighter.Lastname
            </h3>
        </div>

        <div class="card-body">
            <div class="row g-3 mb-4">

                <div class="col-6">
                    <div class="card bg-dark text-white border-secondary h-100">
                        <div class="card-body text-center">
                            <h5 class="text-warning mb-3">
                                Left arm
                            </h5>
                            <button disabled="@isUnconscious" class="btn btn-warning mb-2 w-100 fw-bold" @onclick="OnLeftUppercutClicked">Uppercut</button>
                            <button disabled="@isUnconscious" class="btn btn-warning mb-2 w-100 fw-bold" @onclick="OnLeftHookClicked">Hook</button>
                        </div>
                    </div>
                </div>

                <div class="col-6">
                    <div class="card bg-dark text-white border-secondary h-100">
                        <div class="card-body text-center">
                            <h5 class="text-warning mb-3">
                                Right arm
                            </h5>
                            <button disabled="@isUnconscious" class="btn btn-warning mb-2 w-100 fw-bold" @onclick="OnRightUppercutClicked">Uppercut</button>
                            <button disabled="@isUnconscious" class="btn btn-warning mb-2 w-100 fw-bold" @onclick="OnRightHookClicked">Hook</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-dark border-secondary">
                <div class="card-body text-center">
                    <h5 class="mb-3 text-info" >
                        State
                    </h5>
                    <div class="d-grid gap-2">
                        <button disabled="@isUnconscious" class="btn btn-danger fw-bold" @onclick="OnDowned">Downed</button>
                        <button disabled="@(isUnconscious ? false : true)" class="btn btn-success mb-1" @onclick="OnConsciousRegain">Regain conscious</button>
                    </div>

                </div>
            </div>
        </div>
    }

</div>

@code {
    private bool isUnconscious = false;

    [Parameter]
    public Fighter Fighter { get; set; }

    [Parameter]
    public Guid MatchId { get; set; }

    [Parameter]
    public EventCallback<MatchAttackEvent> OnAttackEvent { get; set; }

    [Parameter]
    public EventCallback<MatchStateEvent> OnStateEvent { get; set; }

    //had to do this cuz string value couldnt be written inside the invoke
    private async Task OnLeftUppercutClicked()
    {
        await OnAttackEvent.InvokeAsync(
            new MatchAttackEvent
            {
                MatchId = this.MatchId,
                Fighter = this.Fighter,
                Limb = "left arm",
                ActionPerformed = "uppercut",
                IsConcious = true
            }
        );
    }

    private async Task OnLeftHookClicked()
    {
        await OnAttackEvent.InvokeAsync(
            new MatchAttackEvent
                {
                    MatchId = this.MatchId,
                    Fighter = this.Fighter,
                    Limb = "left arm",
                    ActionPerformed = "hook",
                    IsConcious = true
                }
        );
    }

    private async Task OnRightUppercutClicked()
    {
        await OnAttackEvent.InvokeAsync(
            new MatchAttackEvent
            {
                MatchId = this.MatchId,
                Fighter = this.Fighter,
                Limb = "right arm",
                ActionPerformed = "uppercut",
                IsConcious = true
            }
        );
    }

    private async Task OnRightHookClicked()
    {
        await OnAttackEvent.InvokeAsync(
            new MatchAttackEvent
            {
                MatchId = this.MatchId,
                Fighter = this.Fighter,
                Limb = "right arm",
                ActionPerformed = "hook",
                IsConcious = true
            }
        );
    }

    private async Task OnDowned()
    {
        await OnStateEvent.InvokeAsync(
            new MatchStateEvent
            {
                MatchId = this.MatchId,
                Fighter = this.Fighter,
                IsConcious = false
            }
        );
        isUnconscious = true;
    }

    private async Task OnConsciousRegain()
    {
        await OnStateEvent.InvokeAsync(
            new MatchStateEvent
            {
                MatchId = this.MatchId,
                Fighter = this.Fighter,
                IsConcious = true
            }
        );
        isUnconscious = false;

    }
}
