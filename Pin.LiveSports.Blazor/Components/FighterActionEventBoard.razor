@using Pin.LiveSports.Blazor.Services
<div class="border border-light border mx-auto px-4" style="background-color:cadetblue;">
    @if(Fighter is null)
    {
        <div>
            <p class="border border-light border-1">Fighter not loaded</p>
        </div>
    }
    else
    {
        <div>
            <p style="display:block">
                @Fighter.Firstname @Fighter.Lastname
            </p>
        </div>
        <div>
            <div class="border border-light border-1">
                <div>
                    <p>
                        Left arm
                    </p>
                </div>
                <button disabled="@isUnconscious" class="btn btn-warning" @onclick="OnLeftUppercutClicked">Uppercut</button>
                <button disabled="@isUnconscious" class="btn btn-warning" @onclick="OnLeftHookClicked">Hook</button>
            </div>

            <div class="border border-light border-1">
                <div>
                    <p>
                        Right arm
                    </p>
                </div>
                <button disabled="@isUnconscious" class="btn btn-warning" @onclick="OnRightUppercutClicked">Uppercut</button>
                <button disabled="@isUnconscious" class="btn btn-warning" @onclick="OnRightHookClicked">Hook</button>
            </div>

            <div class="border border-light border-1">
                <div>
                    <p>
                        State
                    </p>
                </div>
                <div>
                    <button class="btn btn-danger" @onclick="OnDowned">Downed</button>
                </div>
                <div>
                    <button class="btn btn-success" @onclick="OnConsciousRegain">Regain conscious</button>
                </div>
                <div>
                    <button class="btn btn-info" @onclick="OnGrantWin">Grant win</button>
                </div>
            </div>
        </div>
    }


    
</div>

@code {
    private bool isUnconscious = false;

    [Parameter]
    public Fighter Fighter { get; set; }

    [Parameter]
    public Guid MatchId { get; set; }

        [Parameter]
    public EventCallback<BaseMatchEvent> OnFightEvent { get; set; }

    [Parameter]
    public EventCallback<MatchResultEvent> OnWin { get; set; }


    //had to do this cuz string value couldnt be written inside the invoke
    private void OnLeftUppercutClicked()
    {
        OnFightEvent.InvokeAsync(
            new MatchEvent
            {
                MatchId = this.MatchId,
                Fighter = this.Fighter,
                Limb = "left arm",
                ActionPerformed = "uppercut",
                IsConcious = true
            }
        );
    }

    private void OnLeftHookClicked()
    {
        OnFightEvent.InvokeAsync(
            new MatchEvent
                {
                    MatchId = this.MatchId,
                    Fighter = this.Fighter,
                    Limb = "left arm",
                    ActionPerformed = "hook",
                    IsConcious = true
                }
        );
    }

    private void OnRightUppercutClicked()
    {
        OnFightEvent.InvokeAsync(
            new MatchEvent
            {
                MatchId = this.MatchId,
                Fighter = this.Fighter,
                Limb = "right arm",
                ActionPerformed = "uppercut",
                IsConcious = true
            }
        );
    }

    private void OnRightHookClicked()
    {
        OnFightEvent.InvokeAsync(
            new MatchEvent
            {
                MatchId = this.MatchId,
                Fighter = this.Fighter,
                Limb = "right arm",
                ActionPerformed = "hook",
                IsConcious = true
            }
        );
    }

    private void OnDowned()
    {
        OnFightEvent.InvokeAsync(
            new BaseMatchEvent
            {
                MatchId = this.MatchId,
                Fighter = this.Fighter,
                IsConcious = false
            }
        );
        isUnconscious = true;
    }

    private void OnConsciousRegain()
    {
        OnFightEvent.InvokeAsync(
            new BaseMatchEvent
            {
                MatchId = this.MatchId,
                Fighter = this.Fighter,
                IsConcious = true
            }
        );
        isUnconscious = false;

    }

    private void OnGrantWin()
    {
        OnWin.InvokeAsync(
            new MatchResultEvent
            {
                MatchId = this.MatchId,
                Fighter = this.Fighter
            }
        );
    }

}
