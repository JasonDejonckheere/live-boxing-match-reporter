<div class="border border-light border mx-auto p-4" style="background-color:cadetblue;">
    @if(Fighter is null)
    {
        <div>
            <p class="border border-light border-1">Fighter not loaded</p>
        </div>
    }
    else
    {
        <div>
            <p style="display:block">
                @Fighter.Firstname @Fighter.Lastname
            </p>
        </div>
        <div>
            <div class="mb-2 d-flex justify-content-center gap-3">
                <div class="border border-light border-1 d-flex flex-column align-items-center p-2">
                    <div>
                        <p class="text-decoration-underline">
                            Left arm
                        </p>
                    </div>
                    <button disabled="@isUnconscious" class="btn btn-warning mb-1" style="width: 100%; height: 100%" @onclick="OnLeftUppercutClicked">Uppercut</button>
                    <button disabled="@isUnconscious" class="btn btn-warning mb-1" style="width: 100%; height: 100%" @onclick="OnLeftHookClicked">Hook</button>
                </div>

                <div class="border border-light border-1 d-flex flex-column align-items-center p-2">
                    <div>
                        <p class="text-decoration-underline">
                            Right arm
                        </p>
                    </div>
                    <button disabled="@isUnconscious" class="btn btn-warning mb-1" style="width: 100%; height: 100%" @onclick ="OnRightUppercutClicked">Uppercut</button>
                    <button disabled="@isUnconscious" class="btn btn-warning mb-1" style="width: 100%; height: 100%" @onclick="OnRightHookClicked">Hook</button>
                </div>
            </div>

            <div class="border border-light border-1 d-flex flex-column align-items-center p-2">
                <p class="text-decoration-underline mb-2" >State</p>
                <button class="btn btn-danger mb-1" style="width: 85%;" @onclick="OnDowned">Downed</button>
                <button class="btn btn-success mb-1" style="width: 85%;" @onclick="OnConsciousRegain">Regain conscious</button>
                <button class="btn btn-info mb-1" style="width: 85%;" @onclick="OnGrantWin">Grant win</button>
            </div>
        </div>
    }


    
</div>

@code {
    private bool isUnconscious = false;

    [Parameter]
    public Fighter Fighter { get; set; }

    [Parameter]
    public Guid MatchId { get; set; }

        [Parameter]
    public EventCallback<MatchAttackEvent> OnAttackEvent { get; set; }

    [Parameter]
    public EventCallback<MatchStateEvent> OnStateEvent { get; set; }

    [Parameter]
    public EventCallback<MatchResultEvent> OnWin { get; set; }


    //had to do this cuz string value couldnt be written inside the invoke
    private void OnLeftUppercutClicked()
    {
        OnAttackEvent.InvokeAsync(
            new MatchAttackEvent
            {
                MatchId = this.MatchId,
                Fighter = this.Fighter,
                Limb = "left arm",
                ActionPerformed = "uppercut",
                IsConcious = true
            }
        );
    }

    private void OnLeftHookClicked()
    {
        OnAttackEvent.InvokeAsync(
            new MatchAttackEvent
                {
                    MatchId = this.MatchId,
                    Fighter = this.Fighter,
                    Limb = "left arm",
                    ActionPerformed = "hook",
                    IsConcious = true
                }
        );
    }

    private void OnRightUppercutClicked()
    {
        OnAttackEvent.InvokeAsync(
            new MatchAttackEvent
            {
                MatchId = this.MatchId,
                Fighter = this.Fighter,
                Limb = "right arm",
                ActionPerformed = "uppercut",
                IsConcious = true
            }
        );
    }

    private void OnRightHookClicked()
    {
        OnAttackEvent.InvokeAsync(
            new MatchAttackEvent
            {
                MatchId = this.MatchId,
                Fighter = this.Fighter,
                Limb = "right arm",
                ActionPerformed = "hook",
                IsConcious = true
            }
        );
    }

    private void OnDowned()
    {
        OnStateEvent.InvokeAsync(
            new MatchStateEvent
            {
                MatchId = this.MatchId,
                Fighter = this.Fighter,
                IsConcious = false
            }
        );
        isUnconscious = true;
    }

    private void OnConsciousRegain()
    {
        OnStateEvent.InvokeAsync(
            new MatchStateEvent
            {
                MatchId = this.MatchId,
                Fighter = this.Fighter,
                IsConcious = true
            }
        );
        isUnconscious = false;

    }

    private void OnGrantWin()
    {
        OnWin.InvokeAsync(
            new MatchResultEvent
            {
                MatchId = this.MatchId,
                Fighter = this.Fighter
            }
        );
    }

}
