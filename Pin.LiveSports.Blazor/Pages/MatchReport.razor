@page "/matchreport/{matchId:guid}"

@inject ICrudService<BoxingMatch> matchCrudService
@inject ICrudService<Fighter> fighterCrudService
@inject IInMemoryMatchReportService matchReportService


<div class="container-fluid py-4" style="background-color:#111827; min-height:100vh; color:white;">

    <div class="mb-4 text-center">
        <h2 class="fw-bold">
            Match Report
        </h2>

        @if (!string.IsNullOrEmpty(winMessage))
        {
            <div class="alert alert-success mt-3">
                @winMessage
            </div>
        }

        @if (match is null)
        {
            <NavLink href="/sportmanagement" class="btn btn-success mt-3">
                Back to Sport Management
            </NavLink>
        }

    </div>

    @if (match is not null)
    {
        <div class="text-center mb-4">

            <h5 class="text-secondary">
                @blueFighter.Firstname @blueFighter.Lastname
                <span class="text-white fw-bold mx-2">VS</span>
                @redFighter.Firstname @redFighter.Lastname
            </h5>

            <small class="text-muted">
                @blueFighter.WeightClass
            </small>

        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="card bg-primary text-white shadow h-100">
                    <div class="card-body">
                        <FighterActionEventBoard Fighter="blueFighter"
                                                 MatchId="match.Id"
                                                 OnAttackEvent="AddAttackEvent"
                                                 OnStateEvent="AddStateEvent">
                        </FighterActionEventBoard>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card bg-dark text-white border-secondary shadow h-100">
                    <div class="card-body">
                        <MatchManager MatchId="match.Id"
                                      BlueFighter="blueFighter"
                                      RedFighter="redFighter"
                                      OnMatchWin="AddMatchWinner"
                                      OnRoundWin="AddRoundWinEvent">
                        </MatchManager>
                    </div>
                </div>

            </div>

            <div class="col-lg-4">
                <div class="card bg-danger text-white shadow h-100">
                    <div class="card-body">
                        <FighterActionEventBoard Fighter="redFighter"
                                                 MatchId="match.Id"
                                                 OnAttackEvent="AddAttackEvent"
                                                 OnStateEvent="AddStateEvent">
                        </FighterActionEventBoard>
                    </div>
                </div>
            </div>
        </div>

        <div class="card bg-dark border-secondary mt-4">
            <div class="card-header text-center border-0">
                <h4 class="mb-0 text-warning">
                    Live Match Events <span class="text-muted">(@AllMatchEvents.Count)</span>
                </h4>
            </div>

            <div class="card-body">
                @if (AllMatchEvents is null || !AllMatchEvents.Any())
                {
                    <p class="text-muted text-center mb-0">
                        No events yet…
                    </p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var latestEvent in LatestEvents)
                        {
                            <li class="list-group-item bg-dark text-white border-secondary">
                                @if(latestEvent == LatestEvents.Last())
                                {
                                    <span class="fw-bold">latest: </span>
                                }
                                @latestEvent.ToString()
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
</div>

@code {
    private BoxingMatch match;
    private Fighter blueFighter;
    private Fighter redFighter;
    private string winMessage;
    private BoxClient boxClient;

    //todo: inmemory service
    [Parameter]
    public Guid MatchId { get; set; }

    public List<BaseMatchEvent> AllMatchEvents { get; set; }
    public List<BaseMatchEvent> LatestEvents { get; set; }
    //


    protected override async Task OnInitializedAsync()
    {
        match = await matchCrudService.GetByIdAsync(MatchId);
        blueFighter = await fighterCrudService.GetByIdAsync(match.FighterBlueTeamId);
        redFighter = await fighterCrudService.GetByIdAsync(match.FighterRedTeamId);
        AllMatchEvents = new();
        LatestEvents = new();
        winMessage = string.Empty;
        matchReportService.Add(this);

        boxClient = new BoxClient();
        await boxClient.Start();

    }

    public async Task AddAttackEvent(MatchAttackEvent e)
    {
        AllMatchEvents.Add(e);
        matchReportService.Update(this);
        await boxClient.AddRemoteMatchAttackEvent(e);
        RefreshMatchEvents();
    }

    public async Task AddStateEvent(MatchStateEvent e)
    {
        AllMatchEvents.Add(e);
        matchReportService.Update(this);
        await boxClient.AddRemoteMatchStateEvent(e);
        RefreshMatchEvents();
    }

    public void RefreshMatchEvents()
    {
        AllMatchEvents = matchReportService.GetEventsByMatchId(match.Id);
        LatestEvents = matchReportService.GetLatestEventsByMatchId(match.Id, 5).ToList();
    }

    public async Task AddMatchWinner(MatchResultEvent e)
    {
        match.WinningFighterId = e.Fighter.Id;
        match.IsFinished = true;

        AllMatchEvents.Add(e);
        matchReportService.Update(this);

        await matchCrudService.UpdateAsync(match);

        await boxClient.AddRemoteMatchResultEvent(e);

        winMessage = e.ToString();
        match = null;
    }

    public async Task AddRoundWinEvent(MatchRoundResultEvent e)
    {
        AllMatchEvents.Add(e);
        matchReportService.Update(this);
        await boxClient.AddRemoteMatchRoundResultEvent(e);
        RefreshMatchEvents();
    }

}
