@page "/sportmanagement"

@inject IFighterService fighterService;
@inject IMatchService matchService;

<div class="container-fluid py-4 px-4" style="background-color: #111827; min-height: 100vh; color:white;">
    <div class="mb-4">
        <h1 class="fw-bold display-5">
            Sport Management Dashboard
        </h1>
    </div>


    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger shadow-sm">
            @errorMessage
                <button class="btn bg-transparent text-muted fw-bold" @onclick="RemoveError" >X</button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card shadow-lg border-0 h-100" style="background-color: #1f2937; color:white; border-radius: 16px;">
                <div class="card-header border-0" style="background-color: #0f172a; border-radius: 16px 16px 0 0;">
                    <h3 class="mb-0">
                        Fighters
                    </h3>
                </div>

                <div class="card-body">
                    @if (currentFighter == null)
                    {
                        <FighterList Fighters="allFighters"
                        OnAdd="AddFighter"
                        OnEdit="EditFighter"
                        OnDelete="DeleteFighter">
                        </FighterList>
                    }
                    else
                    {
                        <FighterForm Fighter="currentFighter"
                        OnSave="SaveFighter"
                        OnCancel="RefreshFighter">
                        </FighterForm>
                    }
                </div>

            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-lg border-0 h-100" style="background-color: #1f2937; color:white; border-radius:16px;">
                <div class="card-header border-0" style="background-color: #0f172a; border-radius:16px 16px 0 0;">
                    <h3 class="mb-0">
                        Matches
                    </h3>
                </div>

                <div class="card-body">
                    @if (currentMatch == null)
                    {
                        <MatchList Matches="allmatches"
                        HasCrudRights="true"
                        OnAdd="AddMatch"
                        OnEdit="EditMatch"
                        OnDelete="DeleteMatch">
                        </MatchList>
                    }
                    else
                    {
                        <MatchForm Match="currentMatch"
                        AvailableFighters="allFighters"
                        OnSave="SaveMatch"
                        OnCancel="RefreshMatch">
                        </MatchForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private Fighter currentFighter;
    private Fighter[] allFighters;

    private BoxingMatch currentMatch;
    private BoxingMatch[] allmatches;

    private string errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await RefreshFighter();
        await RefreshMatch();
    }

    //fighter
    public async Task RefreshFighter()
    {
        allFighters = await fighterService.GetAllFightersAsync();
        currentFighter = null;
    }

    public void AddFighter()
    {
        this.currentFighter = new Fighter();
    }

    public async Task EditFighter(Fighter fighter)
    {
        this.currentFighter = await fighterService.GetFighterByIdAsync(fighter.Id);
    }

    public async Task DeleteFighter(Fighter fighter)
    {
        try
        {
            await fighterService.DeleteFighterAsync(fighter);
            await RefreshFighter();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }

    }

    public async Task SaveFighter(Fighter fighter)
    {
        try
        {
            await fighterService.SaveFighterAsync(fighter);
            await RefreshFighter();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save fighter: {ex.Message}";
        }        
    }

    //match

    public async Task RefreshMatch()
    {
        allmatches = await matchService.GetAllMatchesAsync();
        currentMatch = null;
    }


    public void AddMatch()
    {
        this.currentMatch = new BoxingMatch();
    }

    public async Task EditMatch(BoxingMatch Match)
    {
        this.currentMatch = await matchService.GetMatchByIdAsync(Match.Id);
    }

    public async Task DeleteMatch(BoxingMatch match)
    {
        await matchService.DeleteMatchAsync(match);
        await RefreshMatch();
    }

    public async Task SaveMatch(BoxingMatch match)
    {
        try
        {
            await matchService.SaveMatchAsync(match);
            await RefreshMatch();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void RemoveError()
    {
        errorMessage = string.Empty;
    }
}
