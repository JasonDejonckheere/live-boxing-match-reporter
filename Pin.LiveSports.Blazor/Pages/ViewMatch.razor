@page "/viewmatch"
@using Pin.LiveSports.Blazor.Components
@using Pin.LiveSports.Blazor.Services

@inject ICrudService<BoxingMatch> matchService;

<h3>MatchViewing</h3>

@if(currentMatchViewed is null)
{
    <MatchList 
        Matches="allMatches"
        HasCrudRights = "false"
        OnView="SetSelectedMatch">
    </MatchList>
}
else
{
    <MatchInfo
        Match="currentMatchViewed"
        OnFailedLoad="RefreshMatches"
    >
    </MatchInfo>
}

@code {
    private BoxingMatch[] allMatches;
    private BoxingMatch currentMatchViewed;
    // private BoxClient boxClient;

    protected override async Task OnInitializedAsync()
    {
        await RefreshMatches();

        // boxClient = new BoxClient();
        // await boxClient.Start();
        // boxClient.Configure(OnRemoteMatchReport);
    }

    private void SetSelectedMatch(BoxingMatch match)
    {
        currentMatchViewed = match;
    }

    private async Task RefreshMatches()
    {
        allMatches = await matchService.GetAllAsync();
        currentMatchViewed = null;
    }

    
}
